<Project Sdk="Microsoft.NET.Sdk">
  <!-- Purrgram for Windows (Lite). Builds on any OS: `dotnet build -c Release` (see build.sh). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Purrgram</AssemblyName>
    <RootNamespace>Purrgram</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Purrgram</Product>
    <Description>A pixel cat that lives on your desktop</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <!-- Frames are pre-rendered by the Mac app (the export-frames flag) and baked into the exe. -->
    <EmbeddedResource Include="Assets\*.png" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\icon.ico" LogicalName="icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
